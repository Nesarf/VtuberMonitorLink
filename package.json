{
  "name": "vtuber-monitor-link",
  "version": "1.4.0",
  "private": true,
  "description": "Vtuber's Monitor Link — a local-web VTuber intelligence monitor with user-configurable browser, sources, and LLM.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node server/src/index.js",
    "dev:web": "vite --config web/vite.config.js",
    "build": "vite build --config web/vite.config.js",
    "start": "node server/src/index.js",
    "smoke": "node server/scripts/smoke.mjs",
    "sanitize-check": "node server/scripts/sanitize-check.mjs",
    "mock-llm": "node tools/mock-llm.cjs",
    "doctor": "node launcher/launch.cjs --doctor",
    "paths": "node launcher/launch.cjs --paths",
    "build:exe": "node tools/build-portable.cjs",
    "build:portable": "node tools/build-portable.cjs --with-browsers",
    "verify": "node tools/verify-release.cjs",
    "traverse": "node tools/traverse-release.cjs",
    "traverse:ui": "node tools/traverse-ui.cjs",
    "release": "node tools/build-portable.cjs && node tools/verify-release.cjs && node tools/traverse-release.cjs && node tools/traverse-ui.cjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "postject": "^1.0.0-alpha.6"
  },
  "engines": {
    "node": ">=20"
  }
}
