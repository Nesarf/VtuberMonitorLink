# deps & build
node_modules/
dist/
.vite/

# runtime data (never commit)
# These are the directories the app only creates **while it is running** (watch history, thumbnails,
# self-check diagnostics, the port file). Missing any one of them replays the same mistake: a tool
# writes it into the repository root one day, and `git add -A` commits it (it really happened with
# advice/ and with mock-vision-port.txt).
config.json
reports/
feeds/
logs/
watch/
thumbs/
advice/
vdb/
mock-vision-port.txt
*.log

# secrets
.env
.env.*
!/.env.example

# OS / editor
Thumbs.db
Desktop.ini
.DS_Store
.idea/
.vscode/*
# Except the task definitions: they are contributor-facing, contain no machine paths, and
# docs/WORKERS.md promises they exist. Everything else under .vscode stays local.
!.vscode/tasks.json
!.vscode/extensions.json

# playwright browser cache (if downloaded locally)
.pw-browsers/

# local private-name list for sanitize-check (never commit)
.sanitize-names


# build intermediates (SEA blob, staged exe)
build/


# worker build outputs: the compiled artifacts of the multilingual layer are built locally by
# `node workers/<language>/build.mjs` and are never committed (see docs/WORKERS.md)
workers/*/dist/
workers/*/build/
workers/*/obj/
workers/*/bin/
# Scratch files inside a worker directory: the convention is a leading underscore, so an
# implementation being written can leave probes and traces behind without polluting the repository.
workers/*/_*
__pycache__/
*.pyc

# machine-local worker registry overlay: tool paths that belong to one computer, never published
workers/registry.local.json


# machine-translation working cache (source-string hash -> translation); machine.json is a product
# of that pipeline and IS committed
web/src/locales/.cache/
