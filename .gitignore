# deps & build
node_modules/
dist/
.vite/

# runtime data (never commit)
# 这几个是**应用跑起来才会产生**的目录（监视历史、缩略图、自检诊断、端口文件）。
# 漏掉任何一个都会重演同一个错误：某个工具有一天把它们写进仓库根目录，
# 然后被 `git add -A` 顺手提交（advice/ 与 mock-vision-port.txt 都真的发生过）。
config.json
reports/
feeds/
logs/
watch/
thumbs/
advice/
mock-vision-port.txt
*.log

# secrets
.env
.env.*
!/.env.example

# OS / editor
Thumbs.db
Desktop.ini
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# playwright browser cache (if downloaded locally)
.pw-browsers/

# local private-name list for sanitize-check (never commit)
.sanitize-names


# build intermediates (SEA blob, staged exe)
build/


# 机器翻译的工作缓存（源串哈希 → 译文）；machine.json 是产物，要提交
web/src/locales/.cache/
