{
  "browser": {
    "mode": "bundled",
    "executablePath": "",
    "profileDir": "",
    "headless": true,
    "waitMs": 6000,
    "hardTimeoutMs": 90000
  },
  "llm": {
    "activeId": "",
    "providers": [],
    "budget": {
      "dailyTokens": 0,
      "onExceed": "warn"
    },
    "provider": "deepseek",
    "baseUrl": "https://api.deepseek.com",
    "apiKey": "",
    "model": "deepseek-chat",
    "reasoningEffort": "high",
    "maxTokens": 8192,
    "temperature": 0.3
  },
  "schedule": {
    "enabled": false,
    "mode": "weekly",
    "dayOfWeek": 2,
    "time": "23:30",
    "merchEveryDays": 14,
    "tasks": []
  },
  "run": {
    "defaultGapSeconds": 2,
    "maxParallel": 3,
    "quarantine": {
      "failures": 3,
      "hours": 6
    },
    "watchWithRun": true,
    "autoFailover": true,
    "diagnoseFailed": true,
    "extractFeatures": true,
    "featureLimit": 40
  },
  "proxy": {
    "enabled": false,
    "url": "",
    "mode": "http",
    "torSocks": "socks5://127.0.0.1:9150",
    "torExe": "",
    "controlUrl": "",
    "controlSecret": ""
  },
  "report": {
    "dormant": {
      "enabled": true,
      "months": 6,
      "maxPeople": 12,
      "maxItems": 2,
      "comebackDays": 3
    }
  },
  "silence": {
    "enabled": true,
    "sampleDays": 20,
    "minDays": 3,
    "maxDays": 90,
    "factor": 2.5,
    "groupQuietDays": 5,
    "minMembers": 3,
    "basisDays": 60
  },
  "observation": {
    "enabled": false,
    "sampleRatio": 0.5,
    "minSources": 2,
    "minWatch": 1,
    "jitterSeconds": [
      3,
      12
    ],
    "torForAgency": true,
    "skipLoginSources": true,
    "rotateExit": true
  },
  "people": [],
  "peopleOptions": {
    "onlyFollowed": false,
    "notifyOnMatch": true,
    "reportMatches": true
  },
  "share": {
    "defaultFormat": "html",
    "verifiedTargets": {},
    "accounts": {},
    "images": {
      "mode": "none",
      "maxPerBundle": 4,
      "maxPerPost": 1,
      "inlineMaxBytes": 204800
    },
    "sites": []
  },
  "vision": {
    "enabled": false,
    "providerId": "",
    "runLimit": 40,
    "concurrency": 2,
    "maxTokens": 300,
    "timeoutMs": 60000,
    "prompt": "",
    "requireVisionModel": true
  },
  "cluster": {
    "enabled": true,
    "threshold": 0.52,
    "windowHours": 72
  },
  "sourceWeights": {},
  "notify": {
    "desktop": true,
    "dedupeMinutes": 0,
    "quietHours": {
      "enabled": false,
      "start": "23:00",
      "end": "08:00",
      "days": "all",
      "timeZone": "",
