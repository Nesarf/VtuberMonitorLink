      "largeEditBytes": 5000,
      "largeDeleteBytes": 2000,
      "newPage": true,
      "anonymousEdit": true,
      "unpatrolled": true,
      "logTypes": [
        "delete",
        "move",
        "protect",
        "block",
        "rights",
        "abusefilter",
        "upload",
        "import"
      ],
      "keywords": [
        "毕业",
        "卒業",
        "解约",
        "引退",
        "炎上",
        "休止",
        "终止",
        "解散",
