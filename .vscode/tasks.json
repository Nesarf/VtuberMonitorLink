{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "workers: what exists",
      "type": "shell",
      "command": "npm run workers -- --list",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "workers: build every implementation",
      "type": "shell",
      "command": "node tools/workers.mjs --build-only",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "workers: conformance run (cross-language diff)",
      "type": "shell",
      "command": "npm run workers",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "workers: conformance for one capability (narrow)",
      "type": "shell",
      "command": "node tools/workers.mjs --published-only --cap ${input:capability}",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "workers: conformance for one worker (narrow)",
      "type": "shell",
      "command": "node tools/workers.mjs --published-only --no-build --only ${input:workerId} --cap ${input:capability}",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "workers: fuzz one capability (generated input, seeded)",
      "type": "shell",
      "command": "npm run workers:diff -- --cap ${input:capability} --n 60 --seed 7",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "workers: re-record the reviewed snapshot",
      "type": "shell",
      "command": "npm run workers:update",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "workers: self-check one language",
      "type": "shell",
      "command": "node workers/${input:workerLanguage}/${input:workerScript} --selfcheck",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "release: fast chain",
      "type": "shell",
      "command": "npm run verify:fast",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "release: full local chain (build + traversal)",
      "type": "shell",
      "command": "npm run release",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    }
  ],
  "inputs": [
    {
      "id": "capability",
      "type": "pickString",
      "description": "which capability",
      "options": ["text.normalize", "text.extract", "text.fingerprint", "search.query", "fetch.plan", "llm.parse"],
      "default": "text.extract"
    },
    {
      "id": "workerId",
      "type": "pickString",
      "description": "which worker (the ids the registry uses, not the language)",
      "options": [
        "js-text",
        "java-text",
        "cpp-text",
        "go-text",
        "python-text",
        "pwsh-text",
        "r-text",
        "bash-text",
        "j-text",
        "js-search",
        "java-search",
        "sql-search",
        "js-fetch",
        "go-fetch",
        "js-llm",
        "python-llm"
      ],
      "default": "go-text"
    },
    {
      "id": "workerLanguage",
      "type": "pickString",
      "description": "which implementation",
      "options": ["js", "java", "cpp", "go", "python", "pwsh", "r", "bash", "j"],
      "default": "js"
    },
    {
      "id": "workerScript",
      "type": "promptString",
      "description": "artifact inside that directory (vmltext.js, dist/vmltext.exe, dist/vmltext.jar)",
      "default": "vmltext.js"
    }
  ]
}
